{
  "name": "embeddable-widget-lead-capture-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable form widgets and a hardened, multi-tenant lead-capture API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "predev": "npm run build:widget",
    "start": "node --env-file=.env src/server.js",
    "prestart": "npm run build:widget",
    "seed": "node --env-file=.env scripts/seed.js",
    "build:widget": "node scripts/build-widget.js",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "migrate": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations",
    "worker": "node --env-file=.env src/jobs/worker.js",
    "test-site": "npx --yes serve test-site -l 5500",
    "pretest": "npm run build:widget"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elyasbromand/Embeddable-Widget-Lead-Capture-Platform.git"
  },
  "author": "Elyas Bromand",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/elyasbromand/Embeddable-Widget-Lead-Capture-Platform/issues"
  },
  "homepage": "https://github.com/elyasbromand/Embeddable-Widget-Lead-Capture-Platform#readme",
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
