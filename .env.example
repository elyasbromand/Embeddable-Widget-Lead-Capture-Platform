# Copy to .env and fill in real values. .env is git-ignored; this file is not.
# Every variable the app reads must appear here with a placeholder.
# The config module (Step 2) validates these at boot and refuses to start if any are wrong.

# --- Server ---
NODE_ENV=development
PORT=3000
# Base URL used in the embed snippet, e.g. <script src="{PUBLIC_BASE_URL}/widget.js?id=...">
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (Step 2) ---
DATABASE_URL=postgres://app:app@localhost:5432/widgets

# --- Auth (Step 3) ---
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- Email (Step 8) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@example.test

# --- Fault injection & dev overrides (off by default) ---
# Step 7: public IP used for geo lookups when the visitor IP is private/loopback (local dev only)
GEO_TEST_IP=
# Step 8: make every confirmation email fail, to prove retries and the dead-letter queue
FORCE_EMAIL_FAILURE=false
