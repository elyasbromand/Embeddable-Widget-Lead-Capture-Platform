# Copy to .env and fill in real values. .env is git-ignored; this file is not.
# Every variable the app reads must appear here with a placeholder.
# The config module (Step 2) validates these at boot and refuses to start if any are wrong.

# --- Server ---
NODE_ENV=development
PORT=3000
# Base URL used in the embed snippet, e.g. <script src="{PUBLIC_BASE_URL}/widget.js?id=...">
PUBLIC_BASE_URL=http://localhost:3000
# pino level: fatal | error | warn | info | debug | trace | silent (optional, default info)
LOG_LEVEL=info

# --- Database (Step 2) ---
# Used by docker-compose to create the Postgres user and database on first start.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=widgets
# Used by the app and migrations. User, password and db name must match the three values above.
DATABASE_URL=postgres://app:change-me@localhost:5432/widgets
# Optional. `npm test` DROPS and recreates this database on every run. Default: DATABASE_URL with
# "_test" added to the db name (here widgets_test). The name must end in _test.
# TEST_DATABASE_URL=postgres://app:change-me@localhost:5432/widgets_test

# --- Auth (Step 3) ---
# At least 32 characters or the app refuses to boot. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- Email (Step 8) ---
# Mailpit (docker compose) catches every email on port 1025; read them at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@example.test

# --- Fault injection & dev overrides (off by default) ---
# Step 7: dev only. When set, geo looks up this IP instead of the visitor's (locally that is always
# 127.0.0.1, which no provider can locate). Example: 8.8.8.8. Must be empty in production (boot fails).
GEO_TEST_IP=
# Step 7: comma-separated geo providers to force down (they throw without calling the network).
# "ip-api.com" = provider A down, "ip-api.com,ipapi.co" = both down. Must be empty in production.
GEO_FORCE_DOWN=
# Step 8: make every confirmation email fail, to prove retries and the dead-letter queue.
# Read by the worker (restart it after changing). Must be false in production (boot fails).
FORCE_EMAIL_FAILURE=false
